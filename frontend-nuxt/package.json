{
  "name": "frontend-nuxt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --port 3004",
    "build": "nuxt prepare && nuxt build",
    "start": "node .output/server/index.mjs",
    "preview": "nuxt preview  --port 3004",
    "generate": "nuxt generate",
    "lint": "eslint . --ext .vue,.js,.ts",
    "lint:fix": "eslint . --ext .vue,.js,.ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:nuxt": "vitest run --project nuxt",
    "check": "npm run lint && npm run format:check && npm run type-check",
    "prepare": "nuxt prepare"
  },
  "dependencies": {
    "@news-portal/types": "file:../packages/types",
    "@pinia/nuxt": "^1.0.1",
    "@primeuix/themes": "^3.0.0",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "nuxt": "^4.5.0",
    "pinia": "^4.0.2",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/eslint-config": "^1.16.0",
    "@nuxt/test-utils": "^4.2.0",
    "@pinia/testing": "^2.0.1",
    "@primevue/nuxt-module": "^4.5.5",
    "@types/node": "^26.1.1",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-nuxt": "^4.0.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.11.15",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  }
}
