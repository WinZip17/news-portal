# Backend URL for Nitro devProxy only (server-side, not exposed to the browser).
# Local backend: http://localhost:3001
# Remote backend: https://short-news.ru
NUXT_API_PROXY_TARGET=http://localhost:3001

# Do NOT set NUXT_PUBLIC_API_BASE — Nuxt maps it to runtimeConfig.public.apiBase
# and the browser would call that URL directly (CORS errors in dev).
# Client requests always go to /api on http://localhost:3004 and are proxied via devProxy.
