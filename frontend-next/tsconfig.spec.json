{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["jest", "node", "@testing-library/jest-dom"],
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.spec.tsbuildinfo"
  },
  "include": [
    "jest.setup.ts",
    "src/**/__tests__/**/*",
    "src/test-utils/**/*"
  ],
  "exclude": ["node_modules", ".next"]
}
